@apiAddress = http://localhost:5152

# <<<<<<<Member Section>>>>>>>
GET {{apiAddress}}/api/Members/GetAllMembers/
Accept: application/json
###

GET {{apiAddress}}/api/Members/GetMember/2
Accept: application/json
###

POST {{apiAddress}}/api/Members/AddMember/
Content-Type: application/json
{
  "name": "Steve",
  "email": "steve@gmail.com"
}

###

PUT {{apiAddress}}/api/Members/EditMember/2
Content-Type: application/json
{
  "memberID": 2,
  "name": "Sara",
  "email": "sara@gmail.com"
}

###
DELETE {{apiAddress}}/api/Members/DeleteMember/2
Accept: application/json

### <<<<<<<Books Section>>>>>>>

GET {{apiAddress}}/api/Books/GetAllBooks/
Accept: application/json

###
GET {{apiAddress}}/api/Books/GetBook/2
Accept: application/json

###

POST {{apiAddress}}/api/Books/AddBook/
Content-Type: application/json
{
    "title": "Code of the Archipelago",
    "author": "Mateo Reyes",
    "description": "A gripping mystery set across the islands of the Philippines, following a software engineer tracing a vanished digital fortune.",
    "availableCopies": 2
}

###

PUT {{apiAddress}}/api/Books/EditBook/2
Content-Type: application/json
{
  "bookID": 2,
  "title": "The Silent Archive",
  "author": "Elena Vance",
  "description": "check"
}

###

DELETE {{apiAddress}}/api/Books/DeleteBook/2
Accept: application/json

###
GET {{apiAddress}}/weatherforecast/
Accept: application/json

